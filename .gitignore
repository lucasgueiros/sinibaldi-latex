# --- Scans ORIGINAIS (vol1.pdf, vol2/vol2.pdf) sao versionados (ver exceção abaixo);
# derivados pesados nunca ---
vol*_div.pdf
vol*_div_ocr.pdf
*_ocr.pdf

# tessdata local (links do sistema + modelos baixados)
tessdata

# --- LaTeX ---
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.synctex.gz
*.xdv
*.nav
*.snm
*.vrb
livro.pdf
build/

# --- Saídas intermediárias de OCR/extração ---
vol*_pag.txt
vol*/vol*.txt
ocr_tmp/
*.tmp
tmp/
scratch/

# --- Árvore por nó (volN/.../): versionar só .tex, .slides.md e estrutura.tsv ---
# o resto é reproduzível: ocr.pdf via tools/corta.py, .txt via extract_paginado,
# .slides.base.md via gera_slides_base, .pptx via md2pptx.
vol*/**/*.pdf
!vol2/vol2.pdf
vol*/**/*.txt
vol*/**/*.slides.base.md
vol*/**/*.pptx

# --- Fase 1 (tools/fase1.sh): volN/paginas/ ---
# versionar: manifesto.tsv, paginas.tsv, <id>.txt, <id>.tsv (linhas/palavras com caixas: e a
# entrada de tools/estruturar_tei.py, e refazer custa ~25 min de OCR) e o TEI volN/volN.xml;
# ignorar: imagens e hOCR bruto do tesseract (regeneraveis).
vol*/paginas/*.png
vol*/paginas/*.hocr
!vol*/paginas/*.txt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Sistema/editor ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# medições de tools/formatacao.py (cache, regenerável)
vol*/paginas/*.medidas.pkl

# editor web (Django)
web/db.sqlite3
web/db.sqlite3-wal
web/db.sqlite3-shm
web/node_modules/
web/staticfiles/
web/cache/

# respostas brutas do LLM nos pre-textuais (o .json de cada pagina basta)
vol*/pretextuais/paginas/*.resp*.txt
