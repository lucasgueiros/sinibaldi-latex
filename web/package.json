{
  "name": "sinibaldi-web",
  "private": true,
  "description": "Build do CSS (TailwindCSS) da edição colaborativa de Sinibaldi",
  "scripts": {
    "build": "tailwindcss -c frontend/tailwind.config.js -i frontend/site.css -o static/css/site.css --minify",
    "watch": "tailwindcss -c frontend/tailwind.config.js -i frontend/site.css -o static/css/site.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
