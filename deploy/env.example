# Referência das variáveis de /etc/sinibaldi/env (o bootstrap gera esse arquivo).
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=sinibaldi.familiagueiros.com.br
CSRF_TRUSTED_ORIGINS=https://sinibaldi.familiagueiros.com.br
DJANGO_HTTPS=true

# PostgreSQL: o MESMO banco do site da Academia (DB_NAME de /etc/academialeaoxiii/env), com papel e
# esquema próprios. O papel só enxerga o esquema DB_SCHEMA (search_path); as tabelas do site
# ficam intocadas. O papel do site recebe leitura do esquema, para o pg_dump dele continuar completo.
DB_NAME=academialeaoxiii
DB_USER=sinibaldi
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=sinibaldi

# Arquivos
STATIC_ROOT=/srv/sinibaldi/static
# imagens do scan (volN/paginas/*.png), PDFs originais, TEI corrigido: enviados por deploy/envia-dados.sh
SINIBALDI_DADOS=/srv/sinibaldi/dados
# PDFs/LaTeX gerados, JPEG reduzidos, gravuras (regenerável)
SINIBALDI_CACHE=/srv/sinibaldi/cache

# E-mail (recuperação de senha, erros para DJANGO_ADMINS)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=contato@sinibaldi.familiagueiros.com.br
DJANGO_ADMINS=
